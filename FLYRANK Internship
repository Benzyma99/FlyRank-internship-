"""
Simple Task API

Run: python "FLYRANK Internship"

This file implements a lightweight REST API for managing tasks using Flask.
Endpoints:
 - GET /tasks
 - GET /tasks/<id>
 - POST /tasks
 - PUT /tasks/<id>
 - DELETE /tasks/<id>

Data is stored in-memory for simplicity.
"""
from flask import Flask, jsonify, request, abort
from uuid import uuid4

app = Flask(__name__)

tasks = {}

def make_task(title, description=""):
    tid = str(uuid4())
    return {
        "id": tid,
        "title": title,
        "description": description,
        "completed": False
    }

@app.route("/tasks", methods=["GET"])
def list_tasks():
    return jsonify(list(tasks.values()))

@app.route("/tasks/<task_id>", methods=["GET"])
def get_task(task_id):
    t = tasks.get(task_id)
    if not t:
        abort(404)
    return jsonify(t)

@app.route("/tasks", methods=["POST"])
def create_task():
    data = request.get_json(force=True)
    title = data.get("title")
    if not title:
        return jsonify({"error": "title is required"}), 400
    description = data.get("description", "")
    t = make_task(title, description)
    tasks[t["id"]] = t
    return jsonify(t), 201

@app.route("/tasks/<task_id>", methods=["PUT"])
def update_task(task_id):
    t = tasks.get(task_id)
    if not t:
        abort(404)
    data = request.get_json(force=True)
    if "title" in data:
        t["title"] = data["title"]
    if "description" in data:
        t["description"] = data["description"]
    if "completed" in data:
        t["completed"] = bool(data["completed"])
    return jsonify(t)

@app.route("/tasks/<task_id>", methods=["DELETE"])
def delete_task(task_id):
    if task_id not in tasks:
        abort(404)
    del tasks[task_id]
    return "", 204

if __name__ == "__main__":
    # add a sample task
    sample = make_task("Sample task", "This is an example task")
    tasks[sample["id"]] = sample
    app.run(host="0.0.0.0", port=5000, debug=True)
